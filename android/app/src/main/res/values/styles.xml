<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme while the app starts: brand launch screen, removed
         when Flutter draws its first frame. The app has a light theme only,
         so night mode uses the same styles (values-night). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window colour behind the Flutter UI (AppColors.background), so no
         white flash between the launch screen and the first frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
